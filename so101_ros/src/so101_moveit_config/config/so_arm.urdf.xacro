<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="include_ros2_control" default="false" />

    <!-- Import so_arm urdf file -->
    <xacro:include filename="$(find so_arm_description)/urdf/so_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="so_arm.ros2_control.xacro" />


    <xacro:so_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
